# Establece la imagen base
FROM node:20-alpine AS builder
WORKDIR /app

# Instala libs necesarias para Prisma Query Engine
RUN apk add --no-cache openssl openssl-dev libc6-compat

# Copia deps e instala
COPY package.json package-lock.json ./
RUN npm ci

# Copia todo el código (incluye prisma/schema.prisma y scripts)
COPY . .

# Corre el build (incluye prisma generate vía prebuild)
RUN npm run build

# Etapa de producción
FROM node:20-alpine AS runner
WORKDIR /app

# Instala libs para Prisma en runtime
RUN apk add --no-cache openssl libc6-compat

# Solo deps de producción
COPY package.json package-lock.json ./
RUN npm ci --omit=dev

# Copia artefactos construidos
COPY --from=builder /app/.next ./.next
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/public ./public
COPY --from=builder /app/prisma ./prisma

EXPOSE 3000

CMD ["npm", "start"]