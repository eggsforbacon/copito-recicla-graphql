// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String  @unique
  name      String
  password  String
}

model Entity {
  id                Int          @id @default(autoincrement())
  name              String
  nameEntity        String
  category          CATEGORY
  email             String       @unique
  city              String
  neighborhood      String
  commune           Int
  position          String
  address           String
  phone             String
  acopio            Boolean?     @default(false)
  acopioName        String?
  prae              Boolean?     @default(false)
  praeName          String?
  proceda           Boolean?     @default(false)
  procedaProject    String?
  committee         Boolean?     @default(false)
  attachment        String?
  reciclyng         Reciclyng[]
  tokens            Token[]
  updateRequests    UpdateRequest[] // Nueva relación
  createdAt         DateTime     @default(now())
}

enum CATEGORY {
  JAC
  CE
}

model Reciclyng {
  id        Int      @id @default(autoincrement())
  weight    Float
  entityId  Int
  entity    Entity   @relation(fields: [entityId], references: [id])
  createdAt DateTime @default(now())
}

model Token {
  id           Int      @id @default(autoincrement())
  token        String   @unique
  email        String
  entityId     Int
  entity       Entity   @relation(fields: [entityId], references: [id])
  weight       Float?
  data         Json?
  isUsed       Boolean  @default(false)
  expiresAt    DateTime
  createdAt    DateTime @default(now())
}

model UpdateRequest {
  id              Int      @id @default(autoincrement())
  entityId        Int
  entity          Entity   @relation(fields: [entityId], references: [id])
  requestedWeight Float?
  updateData      Json?
  status          String   @default("pending")
  createdAt       DateTime @default(now())
}